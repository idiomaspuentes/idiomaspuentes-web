---
import { Image } from "astro:assets";
import imagenPrincipal from "../assets/imagenPrincipal2.png";
import { ArrowRight, Globe, CheckCircle2 } from "@lucide/astro";
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#0A1628] py-20 px-6 md:px-16">
  <!-- Contenedor Principal de Dos Columnas -->
  <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center z-20">
    
    <!-- Columna Izquierda: Textos y Botones -->
    <div class="lg:col-span-7 flex flex-col items-start text-left">
      
      <!-- Etiqueta Superior -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-white text-xs md:text-sm font-medium mb-6 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-[#B35438]"></span>
        MISIÓN LINGÜÍSTICA • AMÉRICA LATINA
      </div>

      <!-- Título Principal -->
      <h1 class="text-4xl md:text-6xl font-serif font-bold text-white leading-tight mb-4">
        La Iglesia equipando a la <span class="text-[#D97757]">Iglesia</span>
      </h1>

      <!-- Párrafo Descriptivo -->
      <p class="text-gray-300 text-base md:text-lg leading-relaxed mb-8 max-w-2xl">
        Trabajamos juntos como un solo cuerpo, respondiendo al llamado de Dios de <strong class="text-white font-semibold">amar y servir a la iglesia tribal.</strong> Los equipamos con todo lo necesario para que sean capaces de traducir las Escrituras al idioma de su corazón y que sus vidas sean transformadas a medida que entienden la Palabra de Dios.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-10">
        <a
          href="/Proyectos"
          class="inline-flex items-center justify-center bg-white hover:bg-gray-100 text-blue-950 font-semibold py-3.5 px-8 rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg"
        >
          Nuestros Proyectos
          <ArrowRight class="ml-2" size="20" />
        </a>
        <a
          href="/Involucrate"
          class="inline-flex items-center justify-center bg-[#B35438] hover:bg-[#96432b] text-white font-semibold py-3.5 px-8 rounded-xl transition-all duration-200 transform hover:scale-105 shadow-lg"
        >
          Involúcrate
          <ArrowRight class="ml-2" size="20" />
        </a>
      </div>

      <!-- Insignia de Idiomas / Estadísticas inferiores -->
      <div class="flex items-center gap-3">
        <div class="flex -space-x-2">
          <span class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-bold border-2 border-[#0A1628]">ES</span>
          <span class="w-8 h-8 rounded-full bg-orange-600 flex items-center justify-center text-white text-xs font-bold border-2 border-[#0A1628]">PT</span>
          <span class="w-8 h-8 rounded-full bg-amber-700 flex items-center justify-center text-white text-xs font-bold border-2 border-[#0A1628]">+50</span>
        </div>
        <p class="text-gray-400 text-sm">
          Facilitando la traducción directa hacia lenguas nativas y originarias.
        </p>
      </div>

    </div>

    <!-- Columna Derecha: Imagen Principal y Tarjeta Flotante -->
    <div class="lg:col-span-5 relative flex justify-center">
      <div class="relative w-full max-w-lg rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-blue-950/40 p-3 backdrop-blur-sm">
        
        <!-- Imagen Principal usando Astro Assets -->
        <Image 
          src={imagenPrincipal} 
          alt="Traducción bíblica en comunidad tribal" 
          class="w-full h-[380px] md:h-[420px] object-cover rounded-xl"
        />

        <!-- Tarjeta Flotante de Metodología -->
        <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-4 rounded-xl shadow-lg border border-gray-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-900 flex items-center justify-center">
              <Globe size="22" />
            </div>
            <div>
              <p class="text-[10px] font-bold tracking-wider text-amber-800 uppercase">METODOLOGÍA PUENTE</p>
              <p class="text-sm font-bold text-gray-900">Español · Portugués → Lengua Materna</p>
            </div>
          </div>
          <div class="text-emerald-600">
            <CheckCircle2 size="24" />
          </div>
        </div>

      </div>
    </div>

  </div>
</section>