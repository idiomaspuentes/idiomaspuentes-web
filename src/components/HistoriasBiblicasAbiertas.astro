---
import { Image } from "astro:assets";
import { BookOpen, CheckCircle2, Download, Languages } from "@lucide/astro";
import BotonPrimario from "./BotonPrimario.astro";
import portadaHistorias from "../assets/Grupal0.jpeg";
import historiasPdf from "../assets/historias-biblicas-abiertas-idiomas-puentes-25.1.pdf";
---

<section
  id="historias-biblicas-abiertas"
  class="scroll-mt-28 bg-gray-50 py-20 md:py-24"
>
  <div class="mx-6 md:mx-50">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="relative overflow-hidden rounded-2xl shadow-lg">
        <Image
          src={portadaHistorias}
          alt="Equipo de traducción revisando Historias Bíblicas Abiertas"
          class="h-80 w-full object-cover md:h-[28rem]"
        />
        <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 to-transparent px-6 py-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-blue-100">
            Recurso completado
          </p>
          <p class="text-2xl font-bold text-white">
            50 historias para evangelización y discipulado
          </p>
        </div>
      </div>

      <div class="space-y-7">
        <div class="inline-flex items-center gap-3 rounded-full bg-blue-100 px-4 py-2 text-blue-900">
          <BookOpen size="20" />
          <span class="text-sm font-semibold">Historias Bíblicas Abiertas</span>
        </div>

        <div class="space-y-4">
          <h2 class="font-serif text-3xl font-bold text-blue-950 md:text-4xl">
            Historias Bíblicas Abiertas en español de Latinoamérica
          </h2>
          <p class="text-lg leading-relaxed text-gray-700">
            Este material reúne relatos claves de la Biblia, desde la creación
            hasta Apocalipsis, en un lenguaje claro para apoyar la traducción
            bíblica, la evangelización y el discipulado en comunidades nativas.
          </p>
          <p class="text-lg leading-relaxed text-gray-700">
            La versión en español de Latinoamérica ya está disponible para
            iglesias, traductores y equipos que desean usarla como recurso
            abierto en su ministerio.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-blue-100 bg-white p-5">
            <div class="mb-3 inline-flex rounded-xl bg-blue-100 p-3 text-blue-800">
              <Languages size="24" />
            </div>
            <h3 class="font-bold text-blue-950">Español latinoamericano</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Preparado como idioma puente para servir a equipos de traducción
              en Latinoamérica.
            </p>
          </div>

          <div class="rounded-xl border border-green-100 bg-white p-5">
            <div class="mb-3 inline-flex rounded-xl bg-green-100 p-3 text-green-700">
              <CheckCircle2 size="24" />
            </div>
            <h3 class="font-bold text-blue-950">100% disponible</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              El recurso completo puede descargarse en PDF para lectura,
              distribución y uso ministerial.
            </p>
          </div>
        </div>

        <BotonPrimario
          href={historiasPdf}
          download="historias-biblicas-abiertas-es-419.pdf"
          class="px-6 py-4"
          aria-label="Descargar Historias Bíblicas Abiertas en PDF"
        >
          <Download class="mr-2" size="20" />
          Descargar PDF en español de Latinoamérica
        </BotonPrimario>
      </div>
    </div>
  </div>
</section>
