---
import { Image } from "astro:assets";
import logo from "../assets/LogoIp.png";
import { Heart, HandHelping, Menu, X } from "@lucide/astro";

const { pathname } = Astro.url;

// Clases limpias para elementos activos e inactivos
const classActivo = "bg-blue-800 text-white py-2.5 px-6 rounded-xl font-medium shadow-sm";
const classInactivo = "text-gray-700 hover:text-blue-900 font-medium py-2 px-3 transition duration-300";

function usarClase(pathActual: string) {
  const normalizedPath = pathname.toLowerCase().replaceAll("/", "");
  const normalizedCurrent = pathActual.toLowerCase().replaceAll("/", "");
  return normalizedPath === normalizedCurrent ? classActivo : classInactivo;
}

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/Nosotros", label: "Nosotros" },
  { href: "/Proyectos", label: "Proyectos" },
  { href: "/Historias", label: "Historias" },
  { href: "/Recursos", label: "Recursos" },
  { href: "/Involucrate", label: "Involúcrate" },
  { href: "/Contacto", label: "Contacto" },
];
---

<nav class="fixed z-50 w-full bg-white/90 backdrop-blur-md py-4 px-6 md:px-12 flex items-center justify-between shadow-sm border-b border-gray-100">
  <!-- Logo / Título -->
  <div class="flex-shrink-0">
    <a href="/" class="text-blue-950 font-extrabold text-lg md:text-xl leading-tight block">
      Idiomas<br />Puentes
    </a>
  </div>

  <!-- Botón Menú Móvil -->
  <div class="md:hidden text-blue-950">
    <input type="checkbox" class="peer hidden" id="menu-toggle" />
    <label class="cursor-pointer p-2 block" for="menu-toggle">
      <Menu size="28" />
    </label>

    <!-- Menú Desplegable Móvil -->
    <div class="fixed inset-0 bg-white z-50 hidden peer-checked:flex flex-col p-6 overflow-y-auto">
      <div class="flex justify-end w-full mb-6">
        <label class="cursor-pointer p-2" for="menu-toggle">
          <X size="28" />
        </label>
      </div>
      <ul class="list-none p-0 m-0 flex flex-col items-center gap-4 text-center">
        {navLinks.map((link) => (
          <li class="w-full">
            <a href={link.href} class={`block text-xl py-3 rounded-xl ${usarClase(link.href)}`}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="w-full mt-4">
          <a
            href="/Donar"
            class="w-full bg-[#B35438] text-white font-medium py-3 px-6 rounded-xl transition duration-300 hover:bg-[#96432b] inline-flex items-center justify-center shadow-md"
          >
            Donar
            <Heart class="ml-2 fill-current" size="20" />
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Menú Escritorio -->
  <ul class="list-none p-0 m-0 items-center hidden md:flex gap-2 lg:gap-4">
    {navLinks.map((link) => (
      <li>
        <a href={link.href} class={`text-sm md:text-base inline-block ${usarClase(link.href)}`}>
          {link.label}
        </a>
      </li>
    ))}

    <li class="ml-4">
      <a
        href="/Donar"
        class="donateBtn bg-[#B35438] text-white font-medium text-sm md:text-base py-2.5 px-6 rounded-xl cursor-pointer transition duration-300 hover:bg-[#96432b] transform hover:scale-105 inline-flex items-center justify-center shadow-md"
      >
        Donar
        <Heart class="ml-2 fill-current" size="18" />
      </a>
    </li>
  </ul>
</nav>