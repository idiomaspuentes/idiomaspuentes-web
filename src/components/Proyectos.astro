---
import Proyecto from "./Tarjetas/TarjetaProyectos.astro";
import { Image } from "astro:assets";
import Grupal1 from "../assets/Grupal1.jpeg";
import Grupal0 from "../assets/Grupal0.jpeg";
import { ArrowUpRight, FolderKanban } from "@lucide/astro";
---

<section class="relative bg-[#FCFBF9] py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Encabezado de la Sección (Alineado a la izquierda con botón a la derecha) -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-16 gap-6">
      <div class="max-w-3xl">
        <!-- Etiqueta Superior -->
        <div class="inline-flex items-center gap-2 text-[#B35438] text-xs font-bold tracking-widest uppercase mb-3">
          <FolderKanban size="14" />
          INICIATIVAS EN MARCHA
        </div>

        <!-- Título Principal -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-blue-950 leading-tight mb-4">
          Nuestros Proyectos
        </h2>

        <!-- Subtítulo / Descripción -->
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed">
          Traducimos al español y portugués recursos bíblicos diseñados para garantizar que la Palabra de Dios sea traducida con fidelidad, claridad y precisión.
        </p>
      </div>

      <!-- Botón Superior Derecho -->
      <div class="flex-shrink-0">
        <a
          href="/Proyectos"
          class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-blue-950 text-sm font-semibold py-2.5 px-5 rounded-xl transition-all duration-200 border border-gray-200 shadow-sm"
        >
          Ver Todos los Proyectos
          <ArrowUpRight size="16" />
        </a>
      </div>
    </div>

    <!-- Grid de Proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      
      <!-- Proyecto 1 -->
      <Proyecto
        categoria="PAQUETES EXEGÉTICOS"
        titulo="Traducción al idioma puente español"
        progreso="PROGRESO ACTUAL"
        porcentaje="6%"
        tipoProgreso="barra"
        descripcion="Una iniciativa que traduce paquetes de recursos de traducción para cada libro de la Biblia, destinada a abrir nuevas puertas al acceso de la Palabra de Dios para más de 55 millones de personas indígenas en Latinoamérica."
        metaTitulo="META"
        metaValor="66 Libros Canónicos"
        alcanceTitulo="ALCANCE"
        alcanceValor="Toda Hispanoamérica"
        conoce="Conoce más sobre este proyecto"
        href="/Proyectos"
        imagen={Grupal1}
      />

      <!-- Proyecto 2 -->
      <Proyecto
        categoria="DISCIPULADO INICIAL"
        titulo="Historias Bíblicas Abiertas en español"
        progreso="COMPLETADO"
        porcentaje="100%"
        tipoProgreso="completado"
        descripcion="Este recurso reúne 50 relatos claves de la Biblia, desde la creación hasta el Apocalipsis, y ya está en manos de dos comunidades indígenas de Latinoamérica como herramienta para la evangelización y el discipulado integral."
        metaTitulo="ESTADO"
        metaValor="Distribuido en Campo"
        alcanceTitulo="FORMATO"
        alcanceValor="Audio · Texto Impreso"
        conoce="Conoce más sobre este proyecto"
        href="/Proyectos#historias-biblicas-abiertas"
        imagen={Grupal0}
      />

    </div>

  </div>
</section>