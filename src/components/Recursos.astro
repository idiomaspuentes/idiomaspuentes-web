---
import Recurso from "./Tarjetas/TarjetaRecursos.astro";
import { BookOpen, BookMarked, Users, FolderOpen, ArrowRight } from "@lucide/astro";
---

<section class="relative bg-[#FCFBF9] py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto text-center">
    
    <!-- Etiqueta Superior -->
    <div class="inline-flex items-center gap-2 text-[#B35438] text-xs font-bold tracking-widest uppercase mb-3">
      ECOSISTEMA LINGÜÍSTICO
    </div>

    <!-- Título Principal -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-blue-950 mt-2 mb-4">
      Recursos Disponibles
    </h2>

    <!-- Subtítulo / Descripción -->
    <p class="text-gray-600 text-base sm:text-lg max-w-3xl mx-auto mb-16 leading-relaxed">
      Herramientas y materiales de libre acceso diseñados para apoyar el trabajo de traducción bíblica y el crecimiento integral de la iglesia.
    </p>

    <!-- Cuadrícula de Tarjetas de Recursos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16">
      
      <!-- Recurso 1 -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col justify-between text-left relative">
        <div>
          <!-- Icono Superior -->
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-900 flex items-center justify-center mb-6">
            <BookOpen size="20" />
          </div>

          <!-- Título -->
          <h3 class="text-xl font-bold text-blue-950 mb-4">
            Los textos fuentes
          </h3>

          <!-- Descripción -->
          <p class="text-gray-600 text-sm leading-relaxed mb-8">
            Para dar vida a una traducción clara y fiel en su propio idioma, los traductores indígenas cuentan con dos versiones de la Biblia en español: el <strong class="text-gray-900">Texto Puente Literal (TPL)</strong>, que conserva la forma del texto original, y el <strong class="text-gray-900">Texto Puente Simple (TPS)</strong>, que expresa su mensaje con sencillez y profundidad.
          </p>
        </div>

        <!-- Pie de Tarjeta -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs font-semibold text-blue-900">TPL · TPS Disponibles</span>
        </div>
      </div>

      <!-- Recurso 2 -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col justify-between text-left relative">
        <div>
          <!-- Icono Superior -->
          <div class="w-10 h-10 rounded-xl bg-orange-50 text-[#B35438] flex items-center justify-center mb-6">
            <BookMarked size="20" />
          </div>

          <!-- Título -->
          <h3 class="text-xl font-bold text-blue-950 mb-4">
            Las ayudas de traducción
          </h3>

          <!-- Descripción -->
          <p class="text-gray-600 text-sm leading-relaxed mb-8">
            Apoyo práctico y contextual para cada etapa: Notas exegéticas, módulos de formación, términos clave del evangelio y preguntas de comprobación de comprensión para comunicar con fidelidad el mensaje.
          </p>
        </div>

        <!-- Pie de Tarjeta -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs font-semibold text-[#B35438]">Notas Exegéticas & Glosarios</span>
        </div>
      </div>

      <!-- Recurso 3 -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col justify-between text-left relative">
        <div>
          <!-- Icono Superior -->
          <div class="w-10 h-10 rounded-xl bg-orange-50 text-[#B35438] flex items-center justify-center mb-6">
            <Users size="20" />
          </div>

          <!-- Título -->
          <h3 class="text-xl font-bold text-blue-950 mb-4">
            Material de discipulado
          </h3>

          <!-- Descripción -->
          <p class="text-gray-600 text-sm leading-relaxed mb-8">
            Recursos que impulsan el crecimiento espiritual de la iglesia local a través de enseñanzas bíblicas que fortalecen la fe, promueven el liderazgo nativo y nutren comunidades maduras.
          </p>
        </div>

        <!-- Pie de Tarjeta -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs font-semibold text-[#B35438]">Guías de Madurez y Estudio</span>
        </div>
      </div>

    </div>

    <!-- Botón Inferior Estilizado -->
    <div class="flex items-center justify-center">
      <a
        href="/Recursos"
        class="inline-flex items-center gap-3 bg-white hover:bg-orange-50/50 text-blue-950 font-semibold py-4 px-8 rounded-2xl transition-all duration-200 border border-orange-200/60 shadow-sm group"
      >
        <div class="w-8 h-8 rounded-lg bg-orange-50 text-[#B35438] flex items-center justify-center">
          <FolderOpen size="16" />
        </div>
        <span>Ver biblioteca completa de Recursos</span>
      </a>
    </div>

  </div>
</section>